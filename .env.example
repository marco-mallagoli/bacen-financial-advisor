# Copy to .env for local development (`make ui`, `adk web` or `adk run`).
# Option A: Vertex AI / Google Cloud (Managed Production / ADC)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Option B: Local Gemini Developer API Key (uncomment for local standalone prototyping)
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GEMINI_API_KEY=your-gemini-api-key

BACEN_BACEN_MCP_URL_SECRET_ID=bacen-mcp-url
# BACEN_MCP_URL=http://127.0.0.1:18081/mcp   # local override only (ignored on Agent Runtime)
# MCP_ID_TOKEN=local-dev                      # local override only

REPORTS_BUCKET=your-project-id-bacen-advisor-reports
MODEL_ARMOR_TEMPLATE=projects/your-project-id/locations/us-central1/templates/bacen-advisor-guardrails
VERTEX_SEARCH_DATASTORE=projects/your-project-id/locations/global/collections/default_collection/dataStores/bacen-methodology-kb

# Model routing (Gemini Flash for routing/collection/critique, Gemini Pro for banking analysis)
MODEL_ROUTER=gemini-flash-latest
MODEL_COLLECTOR=gemini-flash-latest
MODEL_ANALYST=gemini-pro-latest
MODEL_CRITIC=gemini-flash-latest
MODEL_SUMMARIZER=gemini-flash-latest

# Live BCB Olinda API fetch (true = live HTTP + RAM cache + seed fallback; false = instant seed RAM)
ENABLE_LIVE_HTTP_FETCH=false

# Observability & Privacy
PII_REDACTION_MODE=regex     # regex | dlp | off
ENABLE_CLOUD_TRACE=false
LOG_LEVEL=INFO
